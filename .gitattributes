# Ignore all differences in line endings for lock files.
versions.lock text eol=lf
**/*.lockfile text eol=lf

# Gradle files are always in LF.
*.gradle          text eol=lf

# Exclude from source release tarball (git archive).  Avoids ASF license header requirements.
/.*               export-ignore
/dev-docs         export-ignore
AGENTS.md         export-ignore

# Monitoring mixin generated outputs — always LF to ensure make regeneration is idempotent.
solr/monitoring/grafana-solr-dashboard.json text eol=lf
solr/monitoring/prometheus-solr-alerts.yml  text eol=lf

# Contributor-only tooling, excluded from the source release like dev-docs.
solr/monitoring/dev export-ignore
