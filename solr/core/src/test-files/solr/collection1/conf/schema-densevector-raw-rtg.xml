<schema name="densevector-raw-rtg" version="1.6">
  <fieldType name="string" class="solr.StrField"/>
  <fieldType name="plong" class="solr.LongPointField"/>
  <fieldType name="nest_path" class="solr.NestPathField"/>
  <fieldType name="raw_float" class="solr.DenseVectorField" vectorDimension="4"  vectorEncoding="FLOAT32" useRawVectorsAsStored="true"/>
  <fieldType name="raw_byte" class="solr.DenseVectorField" vectorDimension="4" vectorEncoding="BYTE" useRawVectorsAsStored="true"/>
  <fieldType name="raw_float_1d" class="solr.DenseVectorField" vectorDimension="1" vectorEncoding="FLOAT32" useRawVectorsAsStored="true"/>
  <fieldType name="raw_byte_1d" class="solr.DenseVectorField" vectorDimension="1" vectorEncoding="BYTE" useRawVectorsAsStored="true"/>

  <field name="id" type="string" indexed="true" stored="true" required="true"/>
  <field name="_root_" type="string" indexed="true" stored="true"/>
  <field name="_version_" type="plong" indexed="false" stored="false" docValues="true"/>
  <field name="_nest_path_" type="nest_path"/>

  <!-- single valued vector fields -->
  <field name="vector_single_value_float_encoding" type="raw_float" indexed="${tests.rawvectors.indexed:true}" stored="${tests.rawvectors.stored:false}"/>
  <field name="vector_single_value_byte_encoding" type="raw_byte" indexed="${tests.rawvectors.indexed:true}" stored="${tests.rawvectors.stored:false}"/>

  <!-- multivalued vector fields -->
  <field name="vector_multi_value_float_encoding" type="raw_float" indexed="${tests.rawvectors.indexed:true}" stored="${tests.rawvectors.stored:false}" multiValued="true"/>
  <field name="vector_multi_value_byte_encoding" type="raw_byte" indexed="${tests.rawvectors.indexed:true}" stored="${tests.rawvectors.stored:false}" multiValued="true"/>

  <field name="vector_multi_value_float_1d" type="raw_float_1d" indexed="${tests.rawvectors.indexed:true}" stored="${tests.rawvectors.stored:false}" multiValued="true"/>
  <field name="vector_multi_value_byte_1d" type="raw_byte_1d" indexed="${tests.rawvectors.indexed:true}" stored="${tests.rawvectors.stored:false}" multiValued="true"/>

  <!-- for in-place update tests-->
  <field name="counter" type="plong" indexed="false" stored="false" docValues="true"/>

  <!-- for atomic update tests-->
  <field name="a_string_field" type="string" indexed="true" stored="true"/>

  <!-- Edge case: when the vector has 1 as size, we still want a List as a value -->
  <field name="vector_single_value_float_1d" type="raw_float_1d" indexed="${tests.rawvectors.indexed:true}" stored="${tests.rawvectors.stored:false}"/>
  <field name="vector_single_value_byte_1d" type="raw_byte_1d" indexed="${tests.rawvectors.indexed:true}" stored="${tests.rawvectors.stored:false}"/>

  <uniqueKey>id</uniqueKey>
</schema>
