<!--
 SpellCheckComponent counterpart to solrconfig-suggest-buildoncommit-slow.xml: reproduces the
 same "commit blocks/times out instead of just slowing down" issue for a spellchecker configured
 with buildOnCommit=true whose build is slow, and the buildOnCommitAsync opt-in fix for it - see
 AsyncPostCommitRebuilder, which both SuggestComponent and SpellCheckComponent share.

 buildOnCommit and buildOnCommitAsync are driven by system properties (both default true) so
 this one config can serve both scenarios - buildOnCommit=true + buildOnCommitAsync=false (old,
 blocking behavior) and buildOnCommit=true + buildOnCommitAsync=true (new, non-blocking
 behavior) - each in its own core, since these are fixed for the life of a core and can't be
 toggled per-request.
-->
<config>
  <xi:include href="solrconfig.snippet.randomindexconfig.xml" xmlns:xi="http://www.w3.org/2001/XInclude"/>
  <luceneMatchVersion>${tests.luceneMatchVersion:LATEST}</luceneMatchVersion>
  <dataDir>${solr.data.dir:}</dataDir>
  <directoryFactory name="DirectoryFactory" class="solr.NRTCachingDirectoryFactory"/>
  <schemaFactory class="ClassicIndexSchemaFactory"/>

  <updateHandler class="solr.DirectUpdateHandler2"/>

  <requestHandler name="/select" class="solr.SearchHandler" />

  <searchComponent name="slow_spellcheck_build_on_commit" class="solr.SpellCheckComponent">
    <lst name="spellchecker">
      <str name="name">slowSpellChecker</str>
      <str name="classname">org.apache.solr.handler.component.SlowIOSimulatingSpellChecker</str>
      <str name="field">text</str>
      <str name="slowSpellCheckerSleepMs">${solr.tests.slowSpellCheckerSleepMs:2000}</str>
      <str name="buildOnCommit">${solr.tests.spellcheckBuildOnCommit:true}</str>
      <str name="buildOnCommitAsync">${solr.tests.spellcheckBuildOnCommitAsync:true}</str>
    </lst>
  </searchComponent>
  <requestHandler name="/spellcheck_slow" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="spellcheck">true</str>
      <str name="spellcheck.dictionary">slowSpellChecker</str>
    </lst>
    <arr name="components">
      <str>slow_spellcheck_build_on_commit</str>
    </arr>
  </requestHandler>

  <query><useColdSearcher>false</useColdSearcher></query>

</config>
